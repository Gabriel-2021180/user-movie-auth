# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
ENVIRONMENT=development

# Usuario dueño de la BD: lo usan v1 y las migraciones (alembic upgrade head)
DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@HOST/DB?sslmode=require
# Rol de mínimos privilegios para v2 (lo genera scripts/create_runtime_role.py)
DATABASE_URL_RUNTIME=
DB_RUNTIME_PASSWORD=

# Firma de tokens v1 / v2 (mínimo 32 caracteres aleatorios)
SECRET_KEY=
JWT_SECRET=

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# BFF (mismo valor en el .env del front). En local puedes poner REQUIRE_BFF_SECRET=false
BFF_SHARED_SECRET=
REQUIRE_BFF_SECRET=true

# Vercel Cron (purga de cuentas dadas de baja)
CRON_SECRET=

# Orígenes permitidos por CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000

# TMDB (recomendaciones)
TMDB_API_KEY=

# Versiones legales vigentes (deben coincidir con config/legal.ts del front)
LEGAL_TERMS_VERSION=2026-10-03
LEGAL_PRIVACY_VERSION=2026-10-03
