# --- Entornos Virtuales (¡CRÍTICO NO SUBIR ESTO!) ---
venv/
env/
.venv/

# --- Archivos de Entorno (Secretos) ---
.env
.env.local
.env.*

# --- Python Compilado y Caché ---
__pycache__/
*.py[cod]
*$py.class

# --- Bases de Datos Locales ---
*.db
*.sqlite3

# --- Configuración de IDEs (Opcional pero recomendado) ---
.vscode/
.idea/
# --- Secretos y credenciales (permitimos solo la plantilla) ---
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json
.vercel/

# --- Exportaciones de usuarios / dumps de BD (datos personales) ---
*.sql.gz
*.dump
dumps/
exports/

# --- Tests, cobertura y logs ---
.pytest_cache/
.coverage
htmlcov/
*.log
